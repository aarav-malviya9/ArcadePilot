# ArcadePilot Configuration
# AI / LLM Settings (OpenAI-compatible endpoint)
AI_API_BASE=http://127.0.0.1:31415/v1
AI_API_KEY=freellmapi-cf2cfb9ec0e6c32871a4cd553737a5d19ad99073b25dadbf
AI_MODEL=auto
AI_TIMEOUT_SEC=60

# Browser
BROWSER_PROFILE_PATH=%USERPROFILE%\.arcadepilot-browser-profile
BROWSER_TIMEOUT_SEC=30

# Google Cloud (read-only by default)
GCLOUD_PATH=gcloud
GCLOUD_DEFAULT_PROJECT=
GCLOUD_DEFAULT_REGION=us-central1
GCLOUD_DEFAULT_ZONE=us-central1-a

# Safety
APPROVE_DESTRUCTIVE_COMMANDS=false
AUTO_EXECUTE_SAFE_COMMANDS=true
